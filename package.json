{
  "name": "transit-found-phone-reboot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "换乘恋爱第一至五章 · 从原文重译的捡手机互动故事",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.js",
    "audit:presentation": "esbuild scripts/presentation_audit.ts --bundle --platform=node --format=cjs --outfile=scripts/.presentation-audit.cjs && node scripts/.presentation-audit.cjs",
    "check:chapter": "node reboot/audit.mjs",
    "prebuild": "node reboot/assemble-audio.mjs",
    "check:interactions": "node reboot/check-interactions.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
